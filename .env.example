# Copy this file to .env and fill in your values
# NEVER commit .env to git

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Cloudflare Turnstile site key for guest CAPTCHA abuse protection
# VITE_CAPTCHA_SITEKEY=0x4AAAAAA...

# Optional: Telemetry error beacon endpoint (receives non-sensitive stack & route)
# VITE_ERROR_ENDPOINT=https://analytics.example.com/api/errors
